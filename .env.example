# ==============================================================================
# DesignCraft Web / Redacción Editorial Server — Configuración de Entorno
# Para despliegue en Coolify / Docker / Producción
# ==============================================================================

# Puerto y Host (opcional, por defecto 8767 / 0.0.0.0)
PORT=8767
BIND_ADDR=0.0.0.0

# ------------------------------------------------------------------------------
# Motores de Inteligencia Artificial (Opcional para sugerencias y redacción)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
VITE_DEEPSEEK_API_KEY=

# ------------------------------------------------------------------------------
# Google Drive API (Requerido para integración con Google Cloud Drive)
# Configura tu OAuth 2.0 Client ID en Google Cloud Console
# ------------------------------------------------------------------------------
VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_GOOGLE_DRIVE_API_KEY=
VITE_GOOGLE_DRIVE_CLIENT_SECRET=

# IDs de Carpetas en Google Drive
# Obtén los IDs desde la URL de Google Drive: drive.google.com/drive/folders/<ID>
VITE_DRIVE_TEMPLATES_FOLDER_ID=
VITE_DRIVE_DESTINATION_FOLDER_ID=
VITE_GOOGLE_SHEETS_LOG_ID=
VITE_PREVIEW_API_URL=/api-preview

# Modo de almacenamiento: 'google' | 'nextcloud' | 'both'
VITE_STORAGE_MODE=google

# ------------------------------------------------------------------------------
# Nextcloud / OIDC (Configurar solo si se utiliza almacenamiento Nextcloud)
# ------------------------------------------------------------------------------
VITE_NEXTCLOUD_URL=
VITE_NEXTCLOUD_CLIENT_ID=
VITE_NEXTCLOUD_CLIENT_SECRET=
VITE_NEXTCLOUD_TEMPLATES_PATH=/Flujo_editorial/Plantillas
VITE_NEXTCLOUD_DESTINATION_PATH=/Flujo_editorial/Redaccion
VITE_NEXTCLOUD_TEMPLATES_FOLDER_ID=
VITE_NEXTCLOUD_DESTINATION_FOLDER_ID=
